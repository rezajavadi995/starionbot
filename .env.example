APP_ENV=development
TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
POSTGRESQL_URL=postgresql+asyncpg://starion:starion@localhost:5432/starionbot
REDIS_URL=redis://localhost:6379/0
WEBHOOK_SECRET=replace_with_real_webhook_secret
MANDATORY_JOIN_CHANNEL=your_channel_username_without_at
ADMIN_IDS=123456789,987654321
TON_API_KEY=replace_with_real_ton_api_key
TON_WALLET_MNEMONIC=replace_with_real_wallet_mnemonic

STARS_ENABLED=0
STARS_CURRENCY=XTR
STARS_PROVIDER=Telegram Stars XTR
STARS_MIN_TOPUP_XTR=1
# Production HTTPS / Telegram Mini App deployment
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
PANEL_DOMAIN=panel.example.com
MINIAPP_URL=https://example.com/app
WEBHOOK_URL=https://api.example.com/webhook
SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
